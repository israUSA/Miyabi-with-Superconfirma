---
import Icon from "./Icon.astro";

const metrics = [
  { prefix: "+", target: 4800, decimals: 0, suffix: "", label: "Sonrisas creadas" },
  { prefix: "", target: 100, decimals: 0, suffix: "%", label: "Sin dolor ni estrés" },
  { prefix: "", target: 15, decimals: 0, suffix: " Años", label: "De experiencia" },
  { prefix: "", target: 4.9, decimals: 1, suffix: " ★", label: "Opiniones Verificadas" },
];
---

<section id="inicio" class="bg-cream">
  <div
    class="shell flex flex-col items-center gap-12 py-16 lg:flex-row lg:justify-between lg:gap-[60px]"
  >
    <div class="w-full max-w-[680px]">
      <div data-reveal-stagger>
        <div
          data-reveal
          class="inline-flex items-center gap-2 rounded-full border border-gold bg-gold-light px-3.5 py-1.5"
        >
          <Icon name="gem" class="h-3.5 w-3.5 text-gold-dark" />
          <span class="text-[11px] font-bold tracking-[0.13em] text-gold-dark">
            CLÍNICA DENTAL BOUTIQUE
          </span>
        </div>

        <h1
          data-reveal
          class="mt-6 font-display text-[clamp(36px,5vw,52px)] leading-[1.12] font-bold text-ink"
        >
          Tu sonrisa perfecta, diseñada sin dolor.
        </h1>

        <p data-reveal class="mt-6 max-w-xl text-base leading-[1.65] text-ink-soft">
          Carillas de porcelana, implantes guiados y ortodoncia invisible. Tratamientos indoloros
          con tecnología 3D y atención médica personalizada.
        </p>

        <div data-reveal class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#reservar" class="btn btn-dark btn-shine px-8 py-4">
            <Icon name="calendar-check" class="h-4 w-4" />
            RESERVAR CITA DE VALORACIÓN
          </a>
          <a href="#tratamientos" class="btn btn-ghost gap-2 px-7 py-4">
            Ver Tratamientos
            <Icon name="arrow-right" class="h-3.5 w-3.5 text-ink-soft" />
          </a>
        </div>

        <div
          data-reveal
          class="mt-6 flex flex-wrap gap-x-8 gap-y-5 border-t border-line pt-6"
        >
          {
            metrics.map((metric) => (
              <div class="flex flex-col gap-0.5">
                <span class="font-display text-[22px] font-bold whitespace-nowrap text-ink">
                  {metric.prefix}
                  <span data-counter data-target={metric.target} data-decimals={metric.decimals}>
                    {metric.target.toLocaleString("en-US", {
                      minimumFractionDigits: metric.decimals,
                    })}
                  </span>
                  {metric.suffix}
                </span>
                <span class="text-[11px] text-ink-soft">{metric.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div data-reveal="right" class="w-full max-w-[540px] shrink-0">
      <div data-parallax="0.06" class="flex flex-col gap-4 rounded-lg bg-dark p-6 shadow-stage">
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-line-dark bg-dark-card px-3 py-1.5">
            <Icon name="shield-check" class="h-3.5 w-3.5 text-gold" />
            <span class="text-[11px] font-semibold whitespace-nowrap text-gold">
              Garantía Clínica Vitalicia
            </span>
          </span>
          <span class="hidden items-center gap-1.5 rounded-full border border-line-dark bg-dark-card px-3 py-1.5 sm:inline-flex">
            <Icon name="scan" class="h-3.5 w-3.5 text-mist" />
            <span class="text-[11px] whitespace-nowrap text-mist">Escaneo 3D Sin Pastas</span>
          </span>
        </div>

        <div class="exp-photo h-[150px] w-full overflow-hidden rounded-md sm:h-[180px]">
          <img
            src="/images/hero-smile.jpg"
            alt="Simulación digital 3D de una sonrisa perfecta"
            class="animate-kenburns"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="rounded-md border border-line-dark bg-dark-card p-4">
          <h2 class="text-center font-display text-[22px] font-bold text-white">
            Simulación Digital en 3D
          </h2>
          <p class="mt-2 text-center text-[13px] leading-5 text-mist">
            Visualiza tu resultado antes de comenzar. Carillas cerámicas y diseño facial adaptado a
            tu fisionomía.
          </p>
        </div>

        <div class="flex items-center gap-3.5 rounded-md border border-line-dark bg-dark-card p-4">
          <span
            class="flex h-[46px] w-[46px] shrink-0 items-center justify-center rounded-full border border-gold bg-dark font-display text-base font-bold text-gold"
          >
            AM
          </span>
          <div class="flex flex-col gap-0.5">
            <p class="text-[13px] font-bold text-white">Dr. Alejandro Morales · Director Médico</p>
            <p class="text-[11px] text-mist">
              Cirujano Maxilofacial · Fellowship Estética Suiza &amp; Harvard
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
