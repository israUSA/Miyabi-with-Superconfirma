---
import Icon from "./Icon.astro";

const reviews = [
  {
    quote:
      "«Nunca imaginé que transformar mi sonrisa fuera tan agradable. Cero molestias, el escaneo 3D fue instantáneo y el resultado es tan natural que nadie nota que llevo carillas.»",
    name: "Carolina Herrera R.",
    role: "Empresaria y Coleccionista",
    treatment: "Diseño de Sonrisa 3D (Carillas Suizas)",
  },
  {
    quote:
      "«Recuperé mi sonrisa completa en un solo día. La precisión del equipo médico del Dr. Morales y la calma de la suite privada superaron todas mis expectativas.»",
    name: "Ignacio de la Torre",
    role: "Arquitecto de Interiores",
    treatment: "Implantes Guiados 3D (Carga Inmediata)",
  },
  {
    quote:
      "«La atención personalizada y el nivel de detalle son insuperables. Alineé mis dientes con absoluta discreción y sin alterar mis compromisos profesionales.»",
    name: "Valeria Soler",
    role: "Consultora Financiera",
    treatment: "Ortodoncia Diamond & Blanqueamiento",
  },
];
---

<section id="testimonios" class="bg-cream">
  <div class="shell flex flex-col items-center gap-10 py-20">
    <div class="flex flex-col items-center gap-3.5 text-center" data-reveal-stagger>
      <p class="eyebrow" data-reveal>EXPERIENCIAS DE NUESTROS PACIENTES</p>
      <h2 class="section-title" data-reveal>Sonrisas Reales que Inspiran Confianza</h2>
    </div>

    <div class="grid w-full grid-cols-1 gap-5 md:grid-cols-3" data-reveal-stagger>
      {
        reviews.map((review) => (
          <figure
            data-reveal
            class="card-lift flex flex-col justify-between gap-5 rounded-lg border border-line bg-surface p-7"
          >
            <div>
              <div class="flex items-center gap-1" aria-label="Valoración: 5 de 5 estrellas">
                {Array.from({ length: 5 }).map(() => (
                  <Icon name="star" class="h-3.5 w-3.5 text-gold" filled />
                ))}
              </div>
              <blockquote class="mt-4 text-[13px] leading-[1.6] text-ink">
                {review.quote}
              </blockquote>
            </div>
            <figcaption class="flex flex-col gap-0.5 border-t border-line pt-4">
              <span class="text-[13px] font-bold text-ink">{review.name}</span>
              <span class="text-[11px] text-ink-soft">{review.role}</span>
              <span class="text-[11px] font-semibold text-gold-dark">{review.treatment}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
