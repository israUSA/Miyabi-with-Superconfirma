---
const navItems = ["Omakase", "El Menú", "Nuestra Filosofía", "Bodega de Sake"];
---

<header
  data-elevate
  class="sticky top-0 z-50 flex items-center justify-between border-b border-[var(--border-dark)] bg-[var(--bg-main)] px-16 py-6 transition-colors duration-500 max-lg:px-8 max-md:py-4"
>
  <a href="#" class="flex flex-col gap-0.5">
    <span class="font-display text-[22px] leading-none font-bold tracking-[3px] text-[var(--accent-gold)]">MIYABI&#8202;&nbsp;雅</span>
    <span class="font-body text-[10px] tracking-[2px] text-[var(--text-muted)]">HAUTE CUISINE JAPONAISE</span>
  </a>
  <nav class="flex items-center gap-9 max-lg:hidden" aria-label="Principal">
    {
      navItems.map((item) => (
        <a href="#" class="font-body text-[13px] tracking-[1px] text-[var(--text-light)] transition-colors hover:text-[var(--accent-gold)]">
          {item}
        </a>
      ))
    }
  </nav>
  <a
    href="#reserva"
    class="btn-sheen font-body inline-flex items-center border border-[var(--accent-gold)] px-6 py-2.5 text-[12px] font-semibold tracking-[1.5px] text-[var(--accent-gold)] transition-colors duration-300 hover:bg-[var(--accent-gold)] hover:text-[var(--bg-main)]"
  >
    RESERVAR
  </a>
</header>
