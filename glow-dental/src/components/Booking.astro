---
import Icon from "./Icon.astro";

const treatmentChips = [
  "Diseño de Sonrisa 3D",
  "Implantes Guiados 3D",
  "Ortodoncia Diamond",
  "Blanqueamiento Láser",
  "Revisión & Spa Dental",
];

const doctors = [
  {
    initials: "AM",
    name: "Dr. Alejandro Morales",
    role: "Director de Estética & Carillas Cerámicas",
    uni: "Harvard & Ginebra · +15 Años Exp.",
    selected: true,
  },
  {
    initials: "EV",
    name: "Dra. Elena Vidal",
    role: "Especialista en Ortodoncia Invisible Diamond",
    uni: "Universidad de Berna · Diamond Apex Provider",
    selected: false,
  },
  {
    initials: "CS",
    name: "Dr. Carlos Santoro",
    role: "Cirujano de Implantes & Carga Inmediata",
    uni: "Frankfurt Institute · Cirugía Guiada 3D",
    selected: false,
  },
];

const days = [
  { day: "Jue 1", month: "Oct", selected: false },
  { day: "Vie 2", month: "Oct", selected: true },
  { day: "Lun 5", month: "Oct", selected: false },
  { day: "Mar 6", month: "Oct", selected: false },
];

const hours = ["10:30 AM", "12:00 PM", "04:30 PM", "06:00 PM"];

const notes = [
  { icon: "shield", text: "Confidencialidad médica y protección de datos RGPD" },
  { icon: "clock-3", text: "Sin tiempos de espera: entrada directa a suite privada" },
  { icon: "sparkles", text: "Escaneo intraoral 3D de alta definición incluido" },
];
---

<section id="reservar" class="bg-cream">
  <div class="shell flex flex-col items-center gap-10 py-20">
    <div class="flex flex-col items-center gap-3.5 text-center" data-reveal-stagger>
      <p class="eyebrow" data-reveal>EXPERIENCIA EXCLUSIVA SIN ESPERAS</p>
      <h2 class="section-title" data-reveal>Reserva Tu Cita de Valoración</h2>
      <p class="section-sub" data-reveal>
        Elige tu tratamiento de interés, tu especialista y tu horario preferido. Un conserje médico
        te asignará una suite privada y confirmará tu cita en minutos.
      </p>
    </div>

    <div
      data-reveal="zoom"
      class="flex w-full max-w-[1080px] flex-col gap-8 rounded-xl border border-line-dark bg-dark p-6 sm:p-10"
    >
      <form class="flex flex-col gap-8" action="#" method="post">
        <div class="flex flex-col gap-4">
          <p class="text-[13px] font-semibold tracking-[0.06em] text-gold">
            1. SELECCIONA EL TRATAMIENTO DE TU INTERÉS
          </p>
          <div class="flex flex-wrap gap-2.5" data-select-group>
            {
              treatmentChips.map((chip, index) => (
                <button
                  type="button"
                  data-select-option
                  class:list={["chip", index === 0 && "is-selected"]}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <Icon name="check" class="chip-check h-3 w-3" strokeWidth={3} />
                  {chip}
                </button>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <p class="text-[13px] font-semibold tracking-[0.06em] text-gold">
            2. ESPECIALISTA MÉDICO ASIGNADO
          </p>
          <div class="grid grid-cols-1 gap-3 md:grid-cols-3" data-select-group>
            {
              doctors.map((doctor) => (
                <button
                  type="button"
                  data-select-option
                  class:list={["doc-card", doctor.selected && "is-selected"]}
                  aria-pressed={doctor.selected ? "true" : "false"}
                >
                  <span class="doc-radio">
                    <Icon name="check" class="doc-radio-check" strokeWidth={3} />
                  </span>
                  <span class="flex flex-col gap-0.5">
                    <span class="text-[13px] font-bold text-white">{doctor.name}</span>
                    <span class="text-[11px] text-gold">{doctor.role}</span>
                    <span class="text-[10px] text-mist">{doctor.uni}</span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <p class="text-[13px] font-semibold tracking-[0.06em] text-gold">
            3. FECHA Y HORARIO DE PREFERENCIA
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div class="flex flex-col gap-3">
              <p class="text-[11px] text-mist">Próximos días disponibles:</p>
              <div class="grid grid-cols-4 gap-2.5" data-select-group>
                {
                  days.map((item) => (
                    <button
                      type="button"
                      data-select-option
                      class:list={["day-pill", item.selected && "is-selected"]}
                      aria-pressed={item.selected ? "true" : "false"}
                    >
                      <span class="day-text text-xs font-bold text-white">{item.day}</span>
                      <span class="month-text text-[10px] text-mist">{item.month}</span>
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="flex flex-col gap-3">
              <p class="text-[11px] text-mist">Horarios en Suite Privada:</p>
              <div class="grid grid-cols-4 gap-2.5" data-select-group>
                {
                  hours.map((hour, index) => (
                    <button
                      type="button"
                      data-select-option
                      class:list={["hour-pill", index === 1 && "is-selected"]}
                      aria-pressed={index === 1 ? "true" : "false"}
                    >
                      {hour}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <p class="text-[13px] font-semibold tracking-[0.06em] text-gold">
            4. DATOS PERSONALES DEL PACIENTE
          </p>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            <div class="flex flex-col gap-1.5">
              <label for="booking-name" class="text-[11px] text-mist">Nombre y Apellidos</label>
              <div class="input-box">
                <Icon name="user" class="h-3.5 w-3.5 shrink-0 text-mist" />
                <input
                  id="booking-name"
                  name="nombre"
                  type="text"
                  value="Sofía Montesdeoca"
                  autocomplete="name"
                />
              </div>
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="booking-phone" class="text-[11px] text-mist">Teléfono / WhatsApp</label>
              <div class="input-box">
                <Icon name="phone" class="h-3.5 w-3.5 shrink-0 text-mist" />
                <input
                  id="booking-phone"
                  name="telefono"
                  type="tel"
                  value="+34 612 345 678"
                  autocomplete="tel"
                />
              </div>
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="booking-email" class="text-[11px] text-mist">Correo Electrónico</label>
              <div class="input-box">
                <Icon name="mail" class="h-3.5 w-3.5 shrink-0 text-mist" />
                <input
                  id="booking-email"
                  name="email"
                  type="email"
                  value="sofia.montes@luxury.com"
                  autocomplete="email"
                />
              </div>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-gold btn-shine">
          <Icon name="calendar-check" class="h-4.5 w-4.5" />
          SOLICITAR RESERVA EN SUITE PRIVADA · CONFIRMACIÓN INMEDIATA
        </button>
      </form>

      <div class="flex flex-col items-center justify-between gap-3 border-t border-line-dark pt-5 sm:flex-row lg:gap-6">
        {
          notes.map((note) => (
            <div class="flex items-center gap-2">
              <Icon name={note.icon} class="h-3.5 w-3.5 shrink-0 text-gold" />
              <p class="text-[11px] text-mist">{note.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
