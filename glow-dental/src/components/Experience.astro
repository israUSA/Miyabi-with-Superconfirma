---
import Icon from "./Icon.astro";

const cards = [
  {
    image: "/images/suite-privada.jpg",
    alt: "Suite privada con instrumentos de precisión esterilizados",
    tag: "CALMA & CONFORT",
    title: "Suites Privadas Individuales",
    desc: "Atención exclusiva en salas insonorizadas con aromaterapia, sillones de descanso y pantallas en techo con streaming.",
    badge: "100% Privacidad · Sin esperas",
  },
  {
    image: "/images/escaneo-digital.jpg",
    alt: "Especialista realizando un escaneo digital intraoral",
    tag: "BIO-PRECISIÓN 3D",
    title: "Escaneo Digital en 60 Segundos",
    desc: "Diagnóstico instantáneo con escáner intraoral 3D. Olvídate de los moldes de pasta y visualiza tu nueva sonrisa en pantalla.",
    badge: "Sin pastas · Simulación digital",
  },
  {
    image: "/images/atencion-sin-estres.jpg",
    alt: "Paciente sonriendo relajada durante su tratamiento",
    tag: "ODONTOLOGÍA SIN DOLOR",
    title: "Atención Sin Estrés ni Prisas",
    desc: "Protocolos de sedación consciente y anestesia computarizada. Dedicamos el tiempo necesario a cada detalle de tu salud.",
    badge: "Cero dolor · Atención 1 a 1",
  },
];
---

<section id="experiencia" class="bg-surface">
  <div class="shell flex flex-col items-center gap-12 py-20">
    <div class="flex flex-col items-center gap-3.5 text-center" data-reveal-stagger>
      <p class="eyebrow" data-reveal>LA EXPERIENCIA GLOW</p>
      <h2 class="section-title" data-reveal>
        Odontología en un Entorno de Calma y Confort
      </h2>
      <p class="section-sub" data-reveal>
        Espacios diseñados para tu máxima serenidad: suites médicas privadas, tecnología 3D y
        atención personalizada sin dolor ni prisas.
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-5 md:grid-cols-3" data-reveal-stagger>
      {
        cards.map((card) => (
          <article
            data-reveal
            class="exp-card card-lift flex flex-col overflow-hidden rounded-lg border border-line bg-cream"
          >
            <div class="exp-photo h-[220px] w-full overflow-hidden">
              <img src={card.image} alt={card.alt} loading="lazy" />
            </div>
            <div class="flex flex-col items-start gap-3.5 p-6">
              <p class="text-[10px] font-bold tracking-[0.12em] text-gold-dark">{card.tag}</p>
              <h3 class="font-display text-xl font-bold text-ink">{card.title}</h3>
              <p class="text-[13px] leading-5 text-ink-soft">{card.desc}</p>
              <div class="mt-1 inline-flex items-center gap-1.5 rounded border border-line bg-surface px-3 py-2">
                <Icon name="check" class="h-3.5 w-3.5 shrink-0 text-gold-dark" strokeWidth={3} />
                <span class="text-[11px] font-semibold text-ink">{card.badge}</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
