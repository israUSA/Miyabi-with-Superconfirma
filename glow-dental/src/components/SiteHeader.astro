---
import Icon from "./Icon.astro";

const links = [
  { label: "Inicio", href: "#inicio" },
  { label: "Qué Ofrecemos", href: "#tratamientos" },
  { label: "Tecnología 3D", href: "#tecnologia" },
  { label: "Experiencia", href: "#experiencia" },
  { label: "Reservar Cita", href: "#reservar", strong: true },
];
---

<header class="site-header">
  <div class="shell">
    <div class="header-bar">
      <a href="#inicio" class="flex items-center gap-3.5" aria-label="GLOW Dental Studio - Inicio">
        <span
          class="flex h-[42px] w-[42px] items-center justify-center rounded bg-dark font-display text-[22px] font-bold text-gold"
        >
          G
        </span>
        <span class="flex flex-col gap-0.5">
          <span class="font-display text-xl font-bold tracking-[0.1em] text-ink">GLOW</span>
          <span class="text-[9px] font-bold tracking-[0.2em] text-gold-dark">
            DENTAL STUDIO · ALTA ESTÉTICA
          </span>
        </span>
      </a>

      <nav class="hidden items-center gap-9 lg:flex" aria-label="Navegación principal">
        {
          links.map((link) => (
            <a href={link.href} class="nav-link" data-nav>
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-3.5 lg:flex">
        <a
          href="https://wa.me/34910882100"
          class="btn btn-shine gap-2 border border-line bg-cream px-4 py-2.5 text-[13px] font-medium text-ink hover:-translate-y-0.5 hover:border-gold"
        >
          <Icon name="phone" class="h-3.5 w-3.5 text-gold-dark" />
          WhatsApp Directo
        </a>
        <a href="#reservar" class="btn btn-shine gap-2 bg-dark px-5 py-3 text-[13px] font-semibold tracking-[0.04em] text-gold hover:-translate-y-0.5 hover:bg-black">
          <Icon name="calendar" class="h-3.5 w-3.5" />
          AGENDAR CITA
        </a>
      </div>

      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded border border-line text-ink lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span data-icon-menu><Icon name="menu" class="h-5 w-5" /></span>
        <span data-icon-close class="hidden"><Icon name="x" class="h-5 w-5" /></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu lg:hidden" data-mobile-menu>
    <nav class="flex flex-col gap-1 py-4" aria-label="Navegación móvil">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded px-3 py-2.5 text-sm transition-colors hover:bg-gold-light hover:text-gold-dark",
              link.strong && "font-semibold",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href="#reservar" class="btn btn-dark mt-3 w-full">AGENDAR CITA</a>
    </nav>
  </div>
</header>
